# ORION configuration — copy to .env and fill in. NEVER commit .env.
# Every value below is a placeholder.

# ---- Backend ----
ORION_ENV=development                 # development | production
ORION_SECRET_KEY=change-me-to-64-random-hex-chars   # JWT signing key: python -c "import secrets;print(secrets.token_hex(32))"
ORION_ACCESS_TOKEN_TTL_S=900
ORION_REFRESH_TOKEN_TTL_S=1209600
ORION_CORS_ORIGINS=http://localhost:8000
ORION_BOOTSTRAP_OWNER_EMAIL=owner@example.com
ORION_BOOTSTRAP_OWNER_PASSWORD=change-me

# ---- Database ----
POSTGRES_USER=orion
POSTGRES_PASSWORD=change-me
POSTGRES_DB=orion
ORION_DATABASE_URL=postgresql+asyncpg://orion:change-me@localhost:5432/orion

# ---- MQTT broker (device link) ----
ORION_MQTT_HOST=localhost
ORION_MQTT_PORT=1883                  # 8883 with TLS in production
ORION_MQTT_TLS=false
ORION_MQTT_USERNAME=orion-backend
ORION_MQTT_PASSWORD=change-me

# ---- Aura AI (Phase 4) — server side only, never in frontend code ----
AURA_PROVIDER=anthropic               # anthropic | mock
ANTHROPIC_API_KEY=
AURA_MODEL=claude-opus-5-5
AURA_EFFORT=medium

# ---- Push notifications (Phase 5) ----
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_FILE=             # path to JSON outside the repo
