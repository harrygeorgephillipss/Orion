# ORION configuration — copy to .env and fill in. NEVER commit .env.
# Every value below is a placeholder.

# ---- Backend ----
ORION_ENV=development                 # development | production
ORION_SECRET_KEY=change-me-to-64-random-hex-chars   # JWT signing key: python -c "import secrets;print(secrets.token_hex(32))"
ORION_ACCESS_TOKEN_TTL_S=900
ORION_REFRESH_TOKEN_TTL_S=1209600
ORION_CORS_ORIGINS=http://localhost:8000,https://localhost   # https://localhost = the Android app
ORION_BOOTSTRAP_OWNER_EMAIL=owner@example.com
ORION_BOOTSTRAP_OWNER_PASSWORD=change-me
ORION_LAN_HOST=                       # address the ESP32 uses to reach this server: home-network IP, or the cloud domain
ORION_GATEWAY_MQTT_PORT=              # broker port for the ESP32: empty = 1883 (home); cloud = 8883 (TLS)
ORION_DOMAIN=                         # cloud only: public domain for HTTPS (Caddy) and the broker's TLS certificate
ORION_MQTT_PLAIN_BIND=                # cloud only: 127.0.0.1:1883 (keep the plain broker port off the internet)
ORION_MQTT_TLS_BIND=                  # cloud only: 8883

# ---- Database ----
POSTGRES_USER=orion
POSTGRES_PASSWORD=change-me
POSTGRES_DB=orion
ORION_DATABASE_URL=postgresql+asyncpg://orion:change-me@localhost:5432/orion

# ---- MQTT broker (device link) ----
ORION_MQTT_HOST=localhost
ORION_MQTT_PORT=1883                  # 8883 with TLS in production
ORION_MQTT_TLS=false
ORION_MQTT_USERNAME=orion-backend
ORION_MQTT_PASSWORD=change-me

# ---- Aura AI (Phase 4) — server side only, never in frontend code ----
AURA_PROVIDER=                         # anthropic | mock (scripted test provider) | empty = basic mode
ANTHROPIC_API_KEY=
AURA_MODEL=                            # Anthropic model ID to use (see the Anthropic models documentation)
AURA_EFFORT=                           # optional: low | medium | high
AURA_REFUSAL_FALLBACK=default          # optional server-side fallback on declined requests ("" to disable)

# ---- Aura voice (Google Cloud Speech-to-Text / Text-to-Speech) — server side only, see docs/VOICE.md ----
VOICE_STT_PROVIDER=                    # google | mock (tests) | empty = device speech recognition only
VOICE_TTS_PROVIDER=                    # google | mock (tests) | empty = device voice only
GOOGLE_CLOUD_API_KEY=                  # API key restricted to Speech-to-Text + Text-to-Speech (or use the next line)
VOICE_GOOGLE_SERVICE_ACCOUNT_FILE=     # path to a service-account JSON file outside the repository
VOICE_GOOGLE_AUTH=                     # "metadata" = use the Google Cloud VM's own identity (no key at all)
VOICE_MAX_AUDIO_BYTES=1000000          # largest accepted recording (about 60 s of Opus audio)

# ---- Push notifications (Phase 5) ----
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_FILE=             # path to JSON outside the repo
PUSH_SIMULATED=false                  # true = also push incidents from simulated devices (testing only)
